# ---- Copy this file to .env and fill in real values ----

# Database (Render/Supabase/Neon provide a connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secret used to sign login tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Server port (platform sets this automatically)
PORT=4000

# Frontend URL — must match where users access the app (no trailing slash)
CLIENT_ORIGIN=https://your-app.onrender.com

# Email (Resend) — create a free account at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Nexora <onboarding@resend.dev>

# Set to "false" if frontend is deployed separately (e.g. on Vercel)
SERVE_FRONTEND=true